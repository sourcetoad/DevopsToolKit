#!/usr/bin/env bash

# Enable auto-export
set -a

if [ -f ".env" ]; then
    # shellcheck source=/dev/null
    source ".env"
fi

# Disable auto-export
set +a

HOP_PATH=$(cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd)
TOOLKIT_PATH=$(dirname "$HOP_PATH")

LOCAL_DOMAIN=
LOCAL_HOST=localhost
LOCAL_PORT=
PROXY_TOKEN=${PINGGY_TOKEN:-}

PINGGY_HOST=${PINGGY_HOST:-pro.pinggy.io}
PINGGY_SSH_PORTS=${PINGGY_SSH_PORT:-443 80}

source "$TOOLKIT_PATH/bin/_helpers"

function describe {
    local COMMAND_NAME=$1
    local ARGS_LIST=${*:2:(($# - 2))}
    local DESCRIPTION=${!#}
    local CONTENT_LENGTH=$((${#COMMAND_NAME} + ${#ARGS_LIST} + ${#DESCRIPTION}))

    local SEGMENTS=()
    SEGMENTS+=("${FG_C}${COMMAND_NAME}")

    if test $# -gt 2; then
        SEGMENTS+=("${FG_M}${ARGS_LIST}")
    fi

    local DOT_COUNT=$((WIDTH - CONTENT_LENGTH - ${#SEGMENTS[@]} - 3 - 1)) # 3 for "hop", 1 for additional space for last segment
    local DOTS
    DOTS=$(printf '%*s' "$DOT_COUNT" "" | tr ' ' '.')
    SEGMENTS+=("${FG_N}${DOTS}")
    SEGMENTS+=("${FG_N}${DESCRIPTION}")

    join " " "${SEGMENTS[@]}" "${RESET}"
}

function display_help() {
    tag "$BG_G$BOLD" "Sourcetoad Proxy"
    echo "A script that makes it easy to proxy your projects via hop."
    echo
    tag "$BG_Y$BOLD" "Options"
    describe "-h, --help" "Display this help message."
    describe "--local-domain" "Overrides the automatically determined local domain."
    describe "--local-host" "Host the tunnel forwards to. Defaults to localhost."
    describe "--local-port" "Overrides the default local port of 80."
    describe "--token" "Pinggy access token. Defaults to \$PINGGY_TOKEN."
    echo
    tag "$BG_Y$BOLD" "Environment"
    describe "PINGGY_TOKEN" "Pinggy access token (shell or project .env)."
    describe "PINGGY_HOST" "Pinggy server. Defaults to pro.pinggy.io."
    describe "PINGGY_SSH_PORT" "Pinggy SSH port. Defaults to 443, falling back to 80."
}

function parse_arg() {
    local key=$1
    local value=$2

    if [ "$value" ]; then
        echo "$value"
    else
        output_error "'${key}' requires a non-empty argument."
        exit 1
    fi
}

while :; do
    option=${1%%=*}
    parsed_value=

    case $1 in
        -h|--help)
            display_help
            exit
            ;;
        --local-domain|--local-host|--local-port|--token)
            if ! parsed_value=$(parse_arg "$@"); then
                echo "$parsed_value"
                exit 1
            fi
            ;;
        --local-domain=?*|--local-host=?*|--local-port=?*|--token=?*)
            if ! parsed_value=$(parse_arg "${1%%=*}" "${1#*=}"); then
                echo "$parsed_value"
                exit 1
            fi
            ;;
        --local-domain=|--local-host=|--local-port=|--token=)
            if ! parsed_value=$(parse_arg "${1%%=*}"); then
                echo "$parsed_value"
                exit 1
            fi
            ;;
        *)
            ;;
    esac

    case $option in
        --local-domain)
            LOCAL_DOMAIN=$parsed_value
            ;;
        --local-host)
            LOCAL_HOST=$parsed_value
            ;;
        --local-port)
            LOCAL_PORT=$parsed_value
            ;;
        --token)
            PROXY_TOKEN=$parsed_value
            ;;
        *)
            break
            ;;
    esac

    if [ "$1" == "$option" ]; then
        shift
    fi
    shift
done

function locate_docker_file {
    local POTENTIAL_FILES=("docker/docker-compose.yml" "docker-compose.yml")
    for file in "${POTENTIAL_FILES[@]}"; do
        if [ -f "$file" ]; then
            echo "$file"
            return
        fi
    done
}
DOCKER_FILE=$(locate_docker_file)

function pick_one_virtual_host_from_file() {
    local FILE=$1
    local EXCEPT=$2

    local HOST_STRING
    local HOSTS=()
    local HOST
    local HOST_OPTIONS=()

    HOST_STRING=$(sed -nr 's/.*VIRTUAL_HOST=(.*)/\1/p' "$FILE")

    # Trim double quotes from HOST_STRING
    HOST_STRING=$(echo "$HOST_STRING" | tr -d '"')

    # Pipe HOST_STRING through envsubst if available
    if command -v envsubst &> /dev/null; then
        HOST_STRING=$(echo "$HOST_STRING" | envsubst)
    else
        >&2 output_warning "envsubst not found. Skipping environment variable substitution."
    fi

    IFS="," read -ra HOSTS <<< "$HOST_STRING"

    for HOST_ENTRY in "${HOSTS[@]}"; do
        if [ "$HOST_ENTRY" != "$EXCEPT" ]; then
            HOST_OPTIONS+=("$HOST_ENTRY")
        fi
    done

    if [ "${#HOST_OPTIONS[@]}" -eq "0" ]; then
        output_error "No VIRTUAL_HOST overrides found in $FILE."
        exit 1
    elif [ "${#HOST_OPTIONS[@]}" -gt "1" ]; then
        PS3="Select a Proxy URL (or quit to exit): "
        while [ -z "$HOST" ]; do
            select opt in "${HOST_OPTIONS[@]}"; do
                if [ -z "$opt" ]; then
                    if [ "$REPLY" == "quit" ]; then
                        output_info "Exiting..."
                        exit 1
                    fi
                    >&2 output_error "Invalid selection: $REPLY. Please enter the number of the option you wish to select."
                    continue
                fi

                HOST=$opt
                break
            done
        done
    else
        HOST=${HOST_OPTIONS[0]}
    fi

    echo "$HOST"
}

function determine_virtual_host() {
    if [ -z "$DOCKER_FILE" ]; then
        output_error "No docker-compose file found."
        exit 1
    fi

    local HOST

    if ! HOST=$(pick_one_virtual_host_from_file "$DOCKER_FILE"); then
        echo "$HOST"
        exit 1
    fi

    echo "$HOST"
}

if [ -z "$LOCAL_DOMAIN" ]; then
    if ! LOCAL_DOMAIN=$(determine_virtual_host); then
        echo "$LOCAL_DOMAIN"
        exit 1
    fi
fi

if [ -z "$LOCAL_PORT" ]; then
    LOCAL_PORT=80
fi

if [ -z "$PROXY_TOKEN" ]; then
    output_error "No Pinggy token found. Set PINGGY_TOKEN (shell or project .env) or pass --token."
    exit 1
fi

echo
output_info "Starting proxy... $FG_C${LOCAL_DOMAIN}$FG_N via $FG_C${LOCAL_HOST}$FG_N:$FG_M${LOCAL_PORT}$RESET -> $FG_C${PINGGY_HOST}$RESET"
output_info "Your public URL will be printed by Pinggy below."
echo

# Rewrite the Host header so nginx-proxy routes to this project without a VIRTUAL_HOST override.
# Pinggy only prints its output with a TTY when a command (the Host rewrite) is passed.
TTY_FLAG=-T
if [ -t 0 ]; then
    TTY_FLAG=-t
fi

for SSH_PORT in $PINGGY_SSH_PORTS; do
    STARTED_AT=$SECONDS

    ssh "$TTY_FLAG" -p "${SSH_PORT}" \
        -R "0:${LOCAL_HOST}:${LOCAL_PORT}" \
        -o StrictHostKeyChecking=no \
        -o ConnectTimeout=10 \
        -o ServerAliveInterval=30 \
        "${PROXY_TOKEN}@${PINGGY_HOST}" \
        "u:Host:${LOCAL_DOMAIN}"
    EXIT_CODE=$?

    # Only fall back when the connection failed quickly, not after a tunnel was running.
    if [ "$EXIT_CODE" -ne 255 ] || [ $((SECONDS - STARTED_AT)) -gt 20 ]; then
        exit "$EXIT_CODE"
    fi

    output_warning "Could not connect to ${PINGGY_HOST} on port ${SSH_PORT}."
done

exit 1
